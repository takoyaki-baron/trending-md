 "cna:CVE-2026-17566": {
  "fetched_at": "2026-11-01T21:22:33.546Z",
  "v": 5,
  "state": "PUBLISHED",
  "assigner": "PostgreSQL",
  "metrics": [
   {
    "version": "3.1",
    "score": 9.9,
    "vector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H",
