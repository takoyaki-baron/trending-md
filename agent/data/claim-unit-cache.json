\",\"name\":\"Xiaoxi Li\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a689\",\"user\":{\"_id\":\"62e52483a944e2a56cd2c6ca\",\"avatarUrl\":\"https://cdn-avatars.huggingface.co/v1/production/uploads/62e52483a944e2a56cd2c6ca/xElM_6teIrP3QI-Run0Bl.jpeg\",\"isPro\":false,\"fullname\":\"Jiejun Tan\",\"user\":\"zstanjj\",\"type\":\"user\",\"name\":\"zstanjj\"},\"name\":\"Jiejun Tan\",\"status\":\"claimed_verified\",\"statusLastChangedAt\":\"2026-11-05T08:45:04.967Z\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68a\",\"name\":\"Zhecan Wang\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68b\",\"name\":\"Shihan Dou\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68c\",\"name\":\"Honglin Guo\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68d\",\"name\":\"Zhiheng Xi\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68e\",\"name\":\"Tao Gui\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a68f\",\"name\":\"Tao Ji\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a690\",\"name\":\"Qi Zhang\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a691\",\"name\":\"Yutao Zhu\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a692\",\"name\":\"Ji-Rong Wen\",\"hidden\":false},{\"_id\":\"6aeacb88870269964d13a693\",\"name\":\"Zhicheng Dou\",\"hidden\":false}],\"mediaUrls\":[\"https://cdn-uploads.huggingface.co/production/uploads/61cd4b833dd34ba1985e0753/0GFlMmuAI0fMjhCxIyrHX.mp4\"],\"publishedAt\":\"2026-11-03T00:00:00.000Z\",\"submittedOnDailyAt\":\"2026-11-04T00:00:00.000Z\",\"title\":\"ToolSpace: Scaling Tool-Centric Environment Synthesis for Long-Horizon Agents\",\"submittedOnDailyBy\":{\"_id\":\"61cd4b833dd34ba1985e0753\",\"avatarUrl\":\"https://cdn-avatars.huggingface.co/v1/production/uploads/61cd4b833dd34ba1985e0753/BfHfrwotoMESpXZOHiIe4.png\",\"isPro\":false,\"fullname\":\"KABI\",\"user\":\"dongguanting\",\"type\":\"user\",\"name\":\"dongguanting\"},\"summary\":\"Large language models are deployed as long-horizon agents that compose diverse tools across MCP services into executable workflows. Existing MCP environment-scaling methods are data-centric: they first synthesize a database and scenario, then derive tools and tasks from them. As a result, tool interfaces may not match real ones, tool compositions are not grounded in execution, and tasks rarely span more than one environment. We propose ToolSpace, a tool-centric framework that reverses this order. ToolSpace mines data, state, and retry dependencies from adjacent calls in execution traces of real MCP services and open agent corpora, using deterministic rules rather than LLM judgment, and clusters the resulting weighted tool-composition graph into environments. Databases are synthesized only for state-mutating environments, while query and stateless tools replay recorded returns. ToolSpace then performs state-aware random walks with rollback and decompiles each chain into a natural-language task with assertion-based checks, keeping only samples that replay successfully from the initial state. Applied to AutomationBench and tau3-Bench Banking, the pipeline produces harder Pro versions on which 7 frontier models drop by up to 38.2 points. Across seven long-horizon tool-use benchmarks, ToolSpace raises Qwen3.6-35B-A3B from 23.0 to 41.0 average score (43.2 with RL) and GLM-5.2 from 44.6 to 56.6, on par with Claude Opus 5. Ablations show that execution-witnessed edges clearly outperform LLM-judged ones, and performance keeps improving with data and environment scale.\",\"upvotes\":36,\"discussionId\":\"6aeacb88870269964d13a694\",\"projectPage\":\"https://toolspace-agent.github.io/\",\"githubRepo\":\"https://github.com/dongguanting/ToolSpace\",\"githubRepoAddedBy\":\"user\",\"ai_summary\":\"ToolSpace constructs realistic multi-environment tool-use benchmarks by mining execution traces, clustering tool compositions, and validating tasks through replayable state-aware random walks.\",\"ai_keywords\":[\"MCP services\",\"tool-centric framework\",\"execution traces\",\"weighted tool-composition graph\",\"state-aware random walks\",\"assertion-based checks\",\"long-horizon tool-use benchmarks\"],\"ai_summary_model\":\"thinkingmachines/Inkling-Small\",\"githubStars\":31,\"organization\":{\"_id\":\"622177ac43826d6f261f8208\",\"name\":\"RUC\",\"fullname\":\"Renmin University of China\",\"avatar\":\"https://cdn-avatars.huggingface.co/v1/production/uploads/61ac8f8a00d01045fca0ad2f/670IAX9A2-BflqA5MiSBW.jpeg\"}},\"canReadDatabase\":false,\"canManagePapers\":false,\"canSubmit\":false,\"hasHfLevelAccess\":false,\"upvoted\":false,\"upvoters\":[{\"_id\":\"61cd4b833dd34ba1985e0753\",\"avatarUrl\":\"https://cdn-avatars.huggingface.co/v1/production/uploads/61cd4b833dd34ba1985e0753/BfHfrwotoMESpXZOHiIe4.png\",\"isPro\":false,\"fullname\":\"KABI\",\"user\":\"dongguanting\",\"type\":\"user\"},{\"_id\":\"6812ccc194073576b7a9dbf8\",\"avatarUrl\":\"https://cdn-avatars.huggingface.co/v1/production/uploads/6812ccc194073576b7a9dbf8/OF26xantQUz7VUZh8YgJ6.jpeg\",\"isPro\":false,\"fullname\":\"Pat Greener\",\"user\":\"PatDark\",\"type\":\"user\"},{\"_id\":\"6821a2765dac8d0dbb154b50\",\"avatarUrl\":\"/avatars/a6f085922a455cb797f83f66c35bbb36.svg\",\"isPro\":false,\"fullname\":\"Chengjun Pan\",\"user\":\"pcj-sudo\",\"type\":\"user\"},{\"_id\":\"6695f14df0ffd8e3a379ad61\",\"avatarUrl\":\"/avatars/cc9719e352718fc56f767d9c310cda5d.svg\",\"isPro\":false,\"fullname\":\"Jiajie Jin\",\"user\":\"jinjiajie\",\"type\":\"user\"},{\"_id\":\"65b71b9e8bb894c96cc7707b\",\"avatarUrl\":\"/avatars/5e432a4efcb2932df3ed34d1c0af8567.svg\",\"isPro\":false,\"fullname\":\"Tao Gui (SII)\",\"user\":\"guixiaotao\",\"type\":\"user\"},{\"_id\":\"661cf0bea4fea4a7e6e1efe6\",\"avatarUrl\":\"/avatars/dda373bd016531d3c6496adcfb8ab11d.svg\",\"isPro\":false,\"fullname\":\"Qiye Cai\",\"user\":\"Kle1n2\",\"type\":\"user\"},{\"_id\":\"64760bb632369fb179586ffe\",\"avatarUrl\":\"/avatars/81bc242db1da0b63a299bc66d4d1c20c.svg\",\"isPro\":false,\"fullname\":\"Huijie Lv\",\"user\":\"huizhang\",\"type\"