 "page:https://cveawg.mitre.org/api/cve/CVE-2026-63393": {
  "v": 2,
  "fetched_at": "2026-10-31T21:03:05.236Z",
  "bytes": 3252,
  "text": "{\"dataType\":\"CVE_RECORD\",\"dataVersion\":\"5.2\",\"cveMetadata\":{\"cveId\":\"CVE-2026-63393\",\"assignerOrgId\":\"a0819718-46f1-4df5-94e2-005712e83aaa\",\"state\":\"PUBLISHED\",\"assignerShortName\":\"GitHub_M\",\"dateReserved\":\"2026-07-16T17:39:30.171Z\",\"datePublished\":\"2026-10-30T22:22:05.735Z\",\"dateUpdated\":\"2026-10-30T22:22:05.735Z\"},\"containers\":{\"cna\":{\"title\":\"OpenSearch SQL plugin: Unsafe cursor deserialization permits server code execution\",\"problemTypes\":[{\"descriptions\":[{\"cweId\":\"CWE-502\",\"lang\":\"en\",\"description\":\"CWE-502: Deserialization of Untrusted Data\",\"type\":\"CWE\"}]}],\"metrics\":[{\"cvssV4_0\":{\"attackVector\":\"NETWORK\",\"attackComplexity\":\"LOW\",\"attackRequirements\":\"NONE\",\"privilegesRequired\":\"LOW\",\"userInteraction\":\"NONE\",\"vulnConfidentialityImpact\":\"HIGH\",\"vulnIntegrityImpact\":\"HIGH\",\"vulnAvailabilityImpact\":\"HIGH\",\"subConfidentialityImpact\":\"NONE\",\"subIntegrityImpact\":\"NONE\",\"subAvailabilityImpact\":\"NONE\",\"baseScore\":8.7,\"baseSeverity\":\"HIGH\",\"vectorString\":\"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N\",\"version\":\"4.0\"}}],\"references\":[{\"name\":\"https://github.com/opensearch-project/sql/security/advisories/GHSA-r8cv-xvqm-4qj4\",\"tags\":[\"x_refsource_CONFIRM\"],\"url\":\"https://github.com/opensearch-project/sql/security/advisories/GHSA-r8cv-xvqm-4qj4\"},{\"name\":\"https://github.com/opensearch-project/sql/pull/5469\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/pull/5469\"},{\"name\":\"https://github.com/opensearch-project/sql/pull/5572\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/pull/5572\"},{\"name\":\"https://github.com/opensearch-project/sql/commit/402a284f1dff3545236480b67f860aa93fb667de\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/commit/402a284f1dff3545236480b67f860aa93fb667de\"},{\"name\":\"https://github.com/opensearch-project/sql/commit/9ab50384d3ad571a14211415fba2f6d26d4c80db\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/commit/9ab50384d3ad571a14211415fba2f6d26d4c80db\"},{\"name\":\"https://github.com/opensearch-project/sql/releases/tag/2.19.6.0\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/releases/tag/2.19.6.0\"},{\"name\":\"https://github.com/opensearch-project/sql/releases/tag/3.7.0.0\",\"tags\":[\"x_refsource_MISC\"],\"url\":\"https://github.com/opensearch-project/sql/releases/tag/3.7.0.0\"}],\"affected\":[{\"vendor\":\"opensearch-project\",\"product\":\"sql\",\"versions\":[{\"version\":\">= 2.8.0.0,  = 3.0.0.0-alpha1, < 3.7.0.0\",\"status\":\"affected\"}]}],\"providerMetadata\":{\"orgId\":\"a0819718-46f1-4df5-94e2-005712e83aaa\",\"shortName\":\"GitHub_M\",\"dateUpdated\":\"2026-10-30T22:22:05.735Z\"},\"descriptions\":[{\"lang\":\"en\",\"value\":\"OpenSearch SQL supports querying OpenSearch data using SQL and Piped Processing Language. In the 2.x line from 2.8.0.0 until 2.19.6.0, and the 3.x line prior to 3.7.0.0, a remote authenticated user with basic read/search permissions can provide a crafted `cursor` parameter to the `plugins/sql` endpoint and trigger unsafe deserialization of untrusted data, resulting in arbitrary code execution on the server. This issue is fixed in repository releases 2.19.6.0 and 3.7.0.0.\"}],\"source\":{\"advisory\":\"GHSA-r8cv-xvqm-4qj4\",\"discovery\":\"UNKNOWN\"}}}}"
 },
