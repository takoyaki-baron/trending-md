  "text": "{\"dataType\":\"CVE_RECORD\",\"dataVersion\":\"5.2\",\"cveMetadata\":{\"cveId\":\"CVE-2026-119597\",\"assignerOrgId\":\"83251b91-4cc7-4094-a5c7-464a1b83ea10\",\"state\":\"PUBLISHED\",\"assignerShortName\":\"VulnCheck\",\"dateReserved\":\"2026-10-30T11:46:45.299Z\",\"datePublished\":\"2026-10-30T13:18:17.101Z\",\"dateUpdated\":\"2026-10-30T13:18:17.101Z\"},\"containers\":{\"cna\":{\"providerMetadata\":{\"orgId\":\"83251b91-4cc7-4094-a5c7-464a1b83ea10\",\"shortName\":\"VulnCheck\",\"dateUpdated\":\"2026-10-30T13:18:17.101Z\"},\"datePublic\":\"2026-10-22T00:00:00.000Z\",\"title\":\"OpenDeepWiki through 2.0.6 Hard-coded JWT Signing Key Admin Token Forgery\",\"descriptions\":[{\"lang\":\"en\",\"value\":\"OpenDeepWiki through 2.0.6 contains a hard-coded JWT signing key vulnerability that allows unauthenticated attackers to forge administrator tokens using the publicly known Jwt:SecretKey in appsettings.json. Attackers can mint HS256 bearer tokens with an Admin role claim to access /api/admin endpoints and control users, roles, repositories, settings, and API keys.\"}],\"problemTypes\":[{\"descriptions\":[{\"lang\":\"en\",\"description\":\"Use of Hard-coded Cryptographic Key\",\"cweId\":\"CWE-321\",\"type\":\"CWE\"}]}],\"affected\":[{\"vendor\":\"AIDotNet\",\"product\":\"OpenDeepWiki\",\"defaultStatus\":\"unaffected\",\"versions\":[{\"version\":\"0\",\"lessThanOrEqual\":\"2.0.6\",\"status\":\"affected\",\"versionType\":\"semver\"}],\"repo\":\"https://github.com/AIDotNet/OpenDeepWiki\"}],\"metrics\":[{\"format\":\"CVSS\",\"cvssV4_0\":{\"version\":\"4.0\",\"vectorString\":\"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N\",\"attackVector\":\"NETWORK\",\"attackComplexity\":\"LOW\",\"attackRequirements\":\"NONE\",\"privilegesRequired\":\"NONE\",\"userInteraction\":\"NONE\",\"vulnConfidentialityImpact\":\"HIGH\",\"vulnIntegrityImpact\":\"HIGH\",\"vulnAvailabilityImpact\":\"HIGH\",\"subConfidentialityImpact\":\"NONE\",\"subIntegrityImpact\":\"NONE\",\"