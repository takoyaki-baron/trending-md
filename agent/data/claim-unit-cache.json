 "cna:CVE-2026-83559": {
  "fetched_at": "2026-11-02T04:14:02.622Z",
  "v": 5,
  "state": "PUBLISHED",
  "assigner": "apache",
  "metrics": [
   {
    "version": "4.0",
    "score": 7.4,
    "vector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:A/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N",
